{
    "name": "ukrainian-charity-alliance/wayforpay-givewp",
    "description": "Wayforpay payment gateway for GiveWP",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "wayforpay/php-sdk": "^1.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wpackagist-plugin/give": "^4.0",
        "php-stubs/wordpress-stubs": "^7.0",
        "phpunit/phpunit": "^9.0",
        "yoast/phpunit-polyfills": "^4.0",
        "wordpress/wordpress": "dev-trunk"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/wordpress/wordpress-develop.git"
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "plugin-check": "bash scripts/plugin-check.sh",
        "release": "bash scripts/release.sh",
        "test": "composer docker:up && ./vendor/bin/phpunit --colors; EXIT=$?; composer docker:down; exit $EXIT",
        "docker:up": "docker compose -f tests/docker-compose.yml up -d --wait",
        "docker:down": "docker compose -f tests/docker-compose.yml down",
        "zip": "composer install --no-dev --optimize-autoloader && zip -q -r wayforpay-givewp.zip . -x@.distignore && composer install",
        "post-install-cmd": [
            "@php -r \"file_exists('tests/wp-tests-config.php') || copy('tests/wp-tests-config.dist.php', 'tests/wp-tests-config.php');\""
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WayforpayGiveWP\\Tests\\": "tests/"
        }
    },
    "extra": {
        "installer-paths": {
            "vendor/{$vendor}/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    }
}
